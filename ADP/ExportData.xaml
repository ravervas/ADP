<Window x:Class="ADP.ExportData"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"       
        xmlns:local="clr-namespace:ADP"
        mc:Ignorable="d"
        Title="Экспорт данных" Height="400" Width="300" ShowInTaskbar="False" ResizeMode="NoResize">
    <Window.Icon>
        <DrawingImage/>
    </Window.Icon>
    <Window.Resources>
        <SolidColorBrush x:Key="ControlColor" Color="{DynamicResource {x:Static SystemColors.ControlColorKey}}"/>
    </Window.Resources>
    <Grid Background="{StaticResource ControlColor}">
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition/>
            <RowDefinition Height="70"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Vertical" VerticalAlignment="Center">
            <TextBlock VerticalAlignment="Center" Margin="20,10,0,0">Шаг 1: Выделите ячейки</TextBlock>
            <TextBlock VerticalAlignment="Center" Margin="20,10,0,10">Шаг 2: Сохраните файл</TextBlock>
        </StackPanel>
        <Separator Grid.Row="2" VerticalAlignment="Top" Margin="5"></Separator>
        <Border Grid.Row="1" Margin="5" BorderThickness="1" BorderBrush="Silver"/>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Height="Auto" Width="Auto">
            <StackPanel x:Name="MyStackPanel" Grid.Row="1" Margin="6" Background="White" Orientation="Vertical">
                <CheckBox Name="MainCheckBox" Content="Исходные данные" IsChecked="True" HorizontalAlignment="Left" Margin="5"/>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Name="OKBut" Content="OK" VerticalAlignment="Center" Width="80" Height="25" Margin="10,20,15,20" Click="OKBut_Click"></Button>
            <Button Name="CancelBut" Content="Отмена" VerticalAlignment="Center" Width="80" Height="25" Margin="0,20,10,20" Click="CancelBut_Click"></Button>
        </StackPanel>
    </Grid>
</Window>
